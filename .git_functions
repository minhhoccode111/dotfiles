#!/usr/bin/env bash
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

run-ssh-agent() {
	if [ -z "$SSH_AGENT_PID" ] || ! kill -0 "$SSH_AGENT_PID" 2>/dev/null; then
		eval "$(ssh-agent -s)" >/dev/null
	fi
	ssh-add -D
}

mhcssh() {
	run-ssh-agent
	ssh-add ~/.ssh/id_ed25519
	git config --global user.name minhhoccode111
	git config --global user.email minhhoccode111@gmail.com
}

