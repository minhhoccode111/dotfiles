# syntax
# set editing-mode vi
# set keymap vi-command (or normal mode, `vi-insert` for insert mode)
# "keyseq": function-name
# bind -l # show a list of functions

set editing-mode vi
set keymap vi-insert
"jj": vi-movement-mode
"\C-p": previous-history
"\C-n": next-history


set keymap vi-command
"H": beginning-of-line
"L": end-of-line
