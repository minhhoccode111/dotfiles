"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" SETTINGS
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" Allow backspace in insert mode
set backspace=indent,eol,start

" Add the g flag to search/replace by default
set gdefault

" Don't reset cursor to start of line when moving around
set nostartofline

" Show the (partial) command as it's being typed
set showcmd

" Make line numbers default
set number

" Use relative line numbers
set relativenumber

" Start scrolling three lines before the horizontal window border
set scrolloff=3

" Always show the status line
set laststatus=2

" setting clipboard on windows
set clipboard=unnamed

" Enable searching as you type
set incsearch

" Case-insensitive searching UNLESS \C or capital letters in search
set ignorecase
set smartcase

" Indentation settings
set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab

" Set highlight on search
set hlsearch

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" MAPPINGS
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" Set <space> as the leader key
let mapleader = "\<Space>"
let maplocalleader = "\<Space>"

" Clear search highlight on pressing <Esc>
nnoremap <Esc> :nohlsearch<CR>

" Enter Normal mode from Insert mode with jj
inoremap jj <esc>

" Center cursor after moving screen
nnoremap n nzzzv
nnoremap N Nzzzv

" H, K, L for line navigation
nnoremap H ^
onoremap H ^
vnoremap H ^

nnoremap L $
onoremap L $
vnoremap L $

nnoremap K %
onoremap K %
vnoremap K %

" Insert new line above and stay in Normal mode
nnoremap O o<esc>

" Window navigation
nnoremap <C-h> <C-w><C-h>
nnoremap <C-l> <C-w><C-l>
nnoremap <C-j> <C-w><C-j>
nnoremap <C-k> <C-w><C-k>

" Save file with <C-s>
inoremap <C-s> <esc>:w<CR>
nnoremap <C-s> :w<CR>

" Join line below but keep cursor position
nnoremap J mzJ`z

" Toggle line numbers
nnoremap <Leader>tn :set number!<CR>
nnoremap <Leader>tr :set relativenumber!<CR>

" Close window
nnoremap <Leader>xx :q<CR>

""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" VISUAL STUDIO MAPPINGS
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

" find file in Visual Studio
nnoremap <leader>ff :vsc Edit.GoToFile<CR>

" LSP-like navigation
nnoremap <leader>ld :vsc Edit.GoToDefinition<CR>
nnoremap <leader>li :vsc Edit.GoToImplementation<CR>
nnoremap <leader>lr :vsc Edit.FindAllReferences<CR>
nnoremap <leader>lk :vsc Edit.QuickInfo<CR>

" rename LSP
nnoremap <leader>rn :vsc Refactor.Rename<CR>
nnoremap <leader>rr :vsc Edit.ReplaceInFiles<CR>

" Tab navigation
nnoremap <C-o> :vsc Window.NextDocumentWindow<CR>
nnoremap <C-i> :vsc Window.PreviousDocumentWindow<CR>

" Jump list navigation
" set in tools > options > environment > keyboard instead
" change 'Alt - P' and 'Alt - N' to View.NavigateBackward and View.NavigateForward instead
" nnoremap <M-p> :vsc View.NavigateBackward<CR>
" nnoremap <M-n> :vsc View.NavigateForward<CR>

" Debugger controls
nnoremap <leader>db :vsc Debug.ToggleBreakpoint<CR>
nnoremap <leader>dB :vsc Debug.NewConditionalBreakpoint<CR>
nnoremap <leader>dc :vsc Debug.RunToCursor<CR>
nnoremap <leader>ds :vsc Debug.Start<CR>
nnoremap <leader>di :vsc Debug.QuickWatch<CR>

" run without debugger
nnoremap <leader><CR> :vsc Debug.StartWithoutDebugging<CR>

" jump to next/previous diagnostic
" can't do inside Visual Studio, only ErrorList usable
" nnoremap <leader>j :vsc View.NextError<CR>
" nnoremap <leader>k :vsc View.PreviousError<CR>

" move lines up/down
" vnoremap <A-j> :vsc Edit.LineDown<CR>
" nnoremap <A-j> :vsc Edit.LineDown<CR>
" vnoremap <A-k> :vsc Edit.LineUp<CR>
" nnoremap <A-k> :vsc Edit.LineUp<CR>

" toggle word wrap
nnoremap <leader>tw :vsc Edit.ToggleWordWrap<CR>

" toggle diagnostics window
" close with <C-x> set in Tools > Options > Environment > Keyboard and find
" command Window.CloseToolWindow
nnoremap <leader>q :vsc View.ErrorList<CR>

" toggle error list
" nnoremap <leader><leader> :vsc View.ErrorList<CR>

" Select all with <C-a>
nnoremap <C-a> :vsc Edit.SelectAll<CR>
inoremap <C-a> <Esc>:vsc Edit.SelectAll<CR>

" toggle solution explorer
nnoremap <leader>nl :vsc View.SolutionExplorer<CR>

" close all opened buffers
" nnoremap <Leader>xa :qa<CR>
nnoremap <leader>xa :vsc File.CloseAllDocuments<CR>

" show current file in solution explorer
" turn off preview tab: Tools > Options > Environment > Tabs and Windows
nnoremap <leader>nc :vsc SolutionExplorer.SyncWithActiveDocument<CR>
